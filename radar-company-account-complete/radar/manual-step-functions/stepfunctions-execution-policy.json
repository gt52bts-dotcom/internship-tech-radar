{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeTechIntelPipelineLambdas",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s1scan",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s1scan:*",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s2compare",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s2compare:*",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s2bquote",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s2bquote:*",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s3evaluate",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s3evaluate:*",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s4validate",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s4validate:*",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s5report",
        "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID_HERE:function:cathay-techintel-v3-s5report:*"
      ]
    },
    {
      "Sid": "AllowStepFunctionsLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogDelivery",
        "logs:GetLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutResourcePolicy",
        "logs:DescribeResourcePolicies",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    }
  ]
}
