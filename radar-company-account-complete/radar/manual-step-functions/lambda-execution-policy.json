{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLambdaCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:092211181371:*"
    },
    {
      "Sid": "AllowListDataBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cathay-techintel-v3-data-092211181371"
    },
    {
      "Sid": "AllowReadWritePipelineObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::cathay-techintel-v3-data-092211181371/*"
    },
    {
      "Sid": "AllowPickLogTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:092211181371:table/cathay-techintel-v3-picks-log"
    },
    {
      "Sid": "AllowReadAnthropicSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:092211181371:secret:cathay-techintel-v3/anthropic-api-key-*"
    }
  ]
}
